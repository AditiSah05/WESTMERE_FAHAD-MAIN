# Postgres connection string (Neon / Vercel Postgres / any Postgres). Required in production.
# Locally, leave it unset to use an in-process dev database in ./.data
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32-byte key (base64 or 64 hex chars) that encrypts two-factor secrets at rest. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=

# Header your host sets with the real client IP, used for login rate limiting (unset = IP not trusted).
# Vercel is detected automatically (x-vercel-forwarded-for).
TRUSTED_IP_HEADER=

# Google sign-in for customers (optional; the button is hidden until both are set).
# Create an OAuth client at console.cloud.google.com > APIs & Services > Credentials, type "Web application",
# and add <SITE_URL>/account/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Public origin of the site (used for the Google redirect URI). Defaults to the request origin.
SITE_URL=
