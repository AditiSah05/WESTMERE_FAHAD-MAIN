# Postgres connection string (Neon / Vercel Postgres / any Postgres). Required in production.
# Locally, leave it unset to use an in-process dev database in ./.data
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# 32-byte key (base64 or 64 hex chars) that encrypts two-factor secrets at rest. Required in production.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_ENCRYPTION_KEY=

# Header your host sets with the real client IP, used for login rate limiting (unset = IP not trusted).
# Vercel is detected automatically (x-vercel-forwarded-for).
TRUSTED_IP_HEADER=
